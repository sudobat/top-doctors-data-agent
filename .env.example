OPENAI_API_KEY=

# Power Automate "When a Teams webhook request is received" HTTP URL.
# The workflow posts an Adaptive Card ({ type: "message", attachments: [...] }).
TEAMS_OUTLIER_WEBHOOK_URL=

GOOGLE_APPLICATION_CREDENTIALS=/home/sudobat/.config/gcp/top-doctors-bq.json
GCP_PROJECT_ID=EL_PROJECTE
BIGQUERY_DATASET=clinic
BIGQUERY_LOCATION=EU
# Optional volume multiplier for npm run db:seed:bq (default 1.0).
# SEED_SCALE=1.0
# Optional byte cap for bq_run_sql. Defaults to 1 GiB.
# BIGQUERY_MAXIMUM_BYTES_BILLED=1073741824

# OpenMetadata (semantic layer catalog) — npm run semantic:up
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_EMAIL=admin@open-metadata.org
OPENMETADATA_PASSWORD=admin
# Optional bot/PAT instead of email/password login:
# OPENMETADATA_JWT_TOKEN=

# Metabase — npm run semantic:up (UI http://localhost:3000)
METABASE_PORT=3000
METABASE_URL=http://localhost:3000
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=metabase
METABASE_DB_NAME=metabase
# Used by npm run semantic:sync-metabase after first-time Metabase setup:
# METABASE_USERNAME=you@topdoctors.com
# METABASE_PASSWORD=