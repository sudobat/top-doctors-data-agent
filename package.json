{
  "name": "top-doctors-data-agent",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "test": "OPENAI_API_KEY=${OPENAI_API_KEY:-test-key-for-unit-tests} tsx --test $(find tests -name '*.test.ts' | sort)",
    "db:down": "docker compose down",
    "db:seed:bq": "node --env-file=.env scripts/seed-bigquery.mjs",
    "db:seed:bq:broken": "node --env-file=.env scripts/seed-bigquery.mjs --broken",
    "semantic:up": "docker compose --profile semantic up -d",
    "semantic:down": "docker compose --profile semantic down",
    "semantic:sync-metabase": "node --env-file=.env scripts/sync-metabase-descriptions.mjs",
    "eval:load": "node --env-file=.env scripts/eval-load-datasets.mjs",
    "eval:run": "node --env-file=.env scripts/eval-run-experiment.mjs",
    "eval:run:data-engineer": "node --env-file=.env scripts/eval-run-experiment.mjs --agent=data-engineer-agent --variant=baseline",
    "eval:run:outlier-analysis": "node --env-file=.env scripts/eval-run-experiment.mjs --agent=outlier-analysis-agent --variant=baseline"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.1.0",
    "@mastra/core": "1.67.0",
    "@mastra/duckdb": "1.9.0",
    "@mastra/libsql": "1.23.0",
    "@mastra/memory": "1.30.0",
    "@mastra/observability": "1.17.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.30.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
